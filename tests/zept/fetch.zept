--TEST--
fetch from _POST superglobal and from a property, with hasValue/getValue (port of tests/Extension/FetchTest.php)
--FILE--
namespace Stub;

class FetchTest
{
	protected values { set, get };

	public function testFetchPost(var b)
	{
		var c;
		if !fetch c, _POST[b] {
			return false;
		}

		return c;
	}

	public function hasValue(name) -> boolean
	{
		// Check if there is a post value for the item
		if isset _POST[name] {
			return true;
		} else {
			// Check if there is a predefined value for it
			if isset this->values[name] {
				return true;
			}
		}

		return false;
	}

	public function getValue(name)
	{
		var value;

		// Check if there is a predefined value for it
		if !fetch value, _POST[name] {
			// Check if there is a post value for the item
			if !fetch value, this->values[name] {
				return null;
			}
		}

		return value;
	}
}
--USAGE--
$test = new \Stub\FetchTest();

$_POST = [
    'somePOST'  => 'some_post',
    'VALUEPOST' => 'some_post2',
    1           => 'one',
    'two'       => 2,
    'three'     => [3],
];

$test->setValues([
    'someVALUE'  => 'some_value',
    'VALUEPOST'  => 'some_value2',
]);

echo var_export($test->testFetchPost(1), true), "\n";
echo var_export($test->testFetchPost('two'), true), "\n";
echo var_export($test->testFetchPost('three'), true), "\n";

// fieldProvider rows: input, expected getValue, hasValue
$rows = [
    ['somePOST', 'some_post', true],
    ['VALUEPOST', 'some_post2', true],
    ['someVALUE', 'some_value', true],
    ['someUNDEFINED', null, false],
    [1, 'one', true],
    ['two', 2, true],
    ['three', [3], true],
];

foreach ($rows as $row) {
    echo var_export($test->hasValue($row[0]), true), "\n";
    echo var_export($test->getValue($row[0]), true), "\n";
}
--EXPECT--
'one'
2
array (
  0 => 3,
)
true
'some_post'
true
'some_post2'
true
'some_value'
false
NULL
true
'one'
true
2
true
array (
  0 => 3,
)
