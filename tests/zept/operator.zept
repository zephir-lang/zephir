--TEST--
Operator: strict identical (#404), identical-with-false (#829), complex if-identical (#1072), bool comparison matrix (#1279) (port of tests/Extension/OperatorTest.php)
--FILE--
namespace Stub;

class Operator
{
    public function testIdentical(param1, param2)
    {
        return param1 === param2;
    }

    public function testIdenticalIfComplex(var input)
    {
        var a, b;
        let a = ["1": input];
        let b = false;

        if b !== a["1"] {
            return true;
        }
        return false;
    }

    public function testIdenticalVarFalse(param)
    {
        return param === FALSE;
    }

    public function testIdenticalFalseVar(param)
    {
        return FALSE === param;
    }

    public function testBoolComparison(varTrue, varFalse)
    {
        var var1 = true;
        var var2 = false;

        return [
            varTrue == var1,
            varTrue === var1,
            varFalse == var2,
            varFalse === var2,
            varTrue != var2,
            varTrue !== var2,
            varFalse != var1,
            varFalse !== var1
        ];
    }
}
--USAGE--
$test = new \Stub\Operator();
echo var_export($test->testIdentical(true, 1), true), "\n";
echo var_export($test->testIdentical(true, 'phalcon'), true), "\n";
echo var_export($test->testIdentical(false, 0), true), "\n";
echo var_export($test->testIdentical(1, '1'), true), "\n";
echo var_export($test->testIdentical(1, 1), true), "\n";
echo var_export($test->testIdentical(true, true), true), "\n";
echo var_export($test->testIdentical('phalcon', 'phalcon'), true), "\n";
echo var_export($test->testIdenticalVarFalse(false), true), "\n";
echo var_export($test->testIdenticalVarFalse(0), true), "\n";
echo var_export($test->testIdenticalVarFalse(''), true), "\n";
echo var_export($test->testIdenticalFalseVar(false), true), "\n";
echo var_export($test->testIdenticalFalseVar(0), true), "\n";
echo var_export($test->testIdenticalFalseVar(''), true), "\n";
echo var_export($test->testIdenticalIfComplex(false), true), "\n";
echo var_export($test->testIdenticalIfComplex(0), true), "\n";
echo var_export($test->testIdenticalIfComplex(''), true), "\n";
$values = $test->testBoolComparison(true, false);
echo var_export($values[0], true), "\n";
echo var_export($values[1], true), "\n";
echo var_export($values[2], true), "\n";
echo var_export($values[3], true), "\n";
echo var_export($values[4], true), "\n";
echo var_export($values[5], true), "\n";
echo var_export($values[6], true), "\n";
echo var_export($values[7], true), "\n";
--EXPECT--
false
false
false
false
true
true
true
true
false
false
true
