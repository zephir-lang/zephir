function product(array $lists): array
{
    $result = [[]];
    foreach ($lists as $list) {
        $next = [];
        foreach ($result as $prefix) {
            foreach ($list as $value) {
                $next[] = array_merge($prefix, [$value]);
            }
        }
        $result = $next;
    }

    return $result;
}

function collect(callable $call): array
{
    $errors = [];
    set_error_handler(function (int $no, string $message) use (&$errors) {
        $errors[] = $message;

        return true;
    });
    try {
        $result = $call();
    } catch (\Throwable $e) {
        $result = get_class($e) . ': ' . $e->getMessage();
    } finally {
        restore_error_handler();
    }

    return [$result, $errors];
}

$operators = array (
  0 => '==',
  1 => '!=',
  2 => '===',
  3 => '!==',
  4 => '<',
  5 => '<=',
  6 => '>',
  7 => '>=',
);
$checked = 0;
$mismatches = 0;
foreach ($cases as [$label, $method, $php, $values]) {
    foreach (product($values) as $args) {
        $checked++;
        $zephir = collect(fn () => $o->$method(...$args));
        $expected = collect(fn () => $php(...$args));
        if ($zephir === $expected) {
            continue;
        }
        $mismatches++;
        $ops = [];
        foreach ($operators as $i => $operator) {
            if (!is_string($zephir[0]) || !is_string($expected[0]) || ($zephir[0][$i] ?? '') !== ($expected[0][$i] ?? '')) {
                $ops[] = $operator;
            }
        }
        echo $label, ' ', json_encode($args), ' [', implode(' ', $ops), ']: zephir ', json_encode($zephir),
            ' php ', json_encode($expected), "\n";
    }
}
echo "checked ", $checked, ", mismatches ", $mismatches, "\n";
--EXPECT--
checked 833, mismatches 0
