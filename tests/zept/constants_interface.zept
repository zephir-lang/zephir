--TEST--
Interface constants: read via interface name, via self (inherited), and statically (port of tests/Extension/ConstantsInterfaceTest.php)
--FILE--
namespace Stub;

interface TestInterface
{
	const C1 = null;
	const C2 = false;
	const C3 = true;
	const C4 = 10;
	const C5 = 10.25;
	const C6 = "test";
}
--FILE--
namespace Stub;

class ConstantsInterface implements TestInterface
{
	public function testReadInterfaceConstant1()
	{
		return TestInterface::C1;
	}

	public function testReadInterfaceConstant2()
	{
		return TestInterface::C2;
	}

	public function testReadInterfaceConstant3()
	{
		return TestInterface::C3;
	}

	public function testReadInterfaceConstant4()
	{
		return TestInterface::C4;
	}

	public function testReadInterfaceConstant5()
	{
		return TestInterface::C5;
	}

	public function testReadInterfaceConstant6()
	{
		return TestInterface::C6;
	}

	public function testReadInheritanceFromInterfaceConstant1()
	{
		return self::C1;
	}

	public function testReadInheritanceFromInterfaceConstant2()
	{
		return self::C2;
	}

	public function testReadInheritanceFromInterfaceConstant3()
	{
		return self::C3;
	}

	public function testReadInheritanceFromInterfaceConstant4()
	{
		return self::C4;
	}

	public function testReadInheritanceFromInterfaceConstant5()
	{
		return self::C5;
	}

	public function testReadInheritanceFromInterfaceConstant6()
	{
		return self::C6;
	}
}
--USAGE--
$test = new \Stub\ConstantsInterface();

// constants declared directly on the interface
echo var_export(\Stub\TestInterface::C1, true), "\n";
echo var_export(\Stub\TestInterface::C2, true), "\n";
echo var_export(\Stub\TestInterface::C3, true), "\n";
echo var_export(\Stub\TestInterface::C4, true), "\n";
echo var_export(\Stub\TestInterface::C5, true), "\n";
echo var_export(\Stub\TestInterface::C6, true), "\n";

// read through the interface name from inside the class
echo var_export($test->testReadInterfaceConstant1(), true), "\n";
echo var_export($test->testReadInterfaceConstant2(), true), "\n";
echo var_export($test->testReadInterfaceConstant3(), true), "\n";
echo var_export($test->testReadInterfaceConstant4(), true), "\n";
echo var_export($test->testReadInterfaceConstant5(), true), "\n";
echo var_export($test->testReadInterfaceConstant6(), true), "\n";

// inherited constants accessed statically on the implementing class
echo var_export(\Stub\ConstantsInterface::C1, true), "\n";
echo var_export(\Stub\ConstantsInterface::C2, true), "\n";
echo var_export(\Stub\ConstantsInterface::C3, true), "\n";
echo var_export(\Stub\ConstantsInterface::C4, true), "\n";
echo var_export(\Stub\ConstantsInterface::C5, true), "\n";
echo var_export(\Stub\ConstantsInterface::C6, true), "\n";

// inherited constants read via self:: from inside the class
echo var_export($test->testReadInheritanceFromInterfaceConstant1(), true), "\n";
echo var_export($test->testReadInheritanceFromInterfaceConstant2(), true), "\n";
echo var_export($test->testReadInheritanceFromInterfaceConstant3(), true), "\n";
echo var_export($test->testReadInheritanceFromInterfaceConstant4(), true), "\n";
echo var_export($test->testReadInheritanceFromInterfaceConstant5(), true), "\n";
echo var_export($test->testReadInheritanceFromInterfaceConstant6(), true), "\n";
--EXPECT--
NULL
false
true
10
10.25
'test'
NULL
false
true
10
10.25
'test'
NULL
false
true
10
10.25
'test'
NULL
false
true
10
10.25
'test'
