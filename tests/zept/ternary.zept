--TEST--
Ternary: long/string ternary, after-let, promoted-temp (#665), short ternary ?: and complex short ternary, nested complex ternaries (port of tests/Extension/TernaryTest.php)
--FILE--
namespace Stub;

class Ternary
{
    public function testTernary1()
    {
        return 100 ? true + 100 : false;
    }

    public function testTernary2(boolean b)
    {
        return b ? "foo" : "bar";
    }

    public function testTernaryComplex1(var a, var y)
    {
        return 100 ? true + 100 : a->y() ? a->x() : isset a[y];
    }

    public function testTernaryComplex2(var a, var y)
    {
        return 5 + (100 ? true + 100 : a->y() ? a->x() : isset a[y]);
    }

    public function testTernaryComplex3(var a)
    {
        return gettype(typeof a == "resource" ? "unknown": false);
    }

    public function testTernaryWithPromotedTemporaryVariable()
    {
        var var2, var3;

        let var2 = ["_b_","_c_"];

        let var3 = explode("_", isset(var2[1]) ? var2[1] : "");

        return var3;
    }

    public function testTernaryAfterLetVariable()
    {
        var s = 23;
        let s = 1===1 ? 3 : 10;
        return s;
    }

    public function testShortTernary(var a) -> var
    {
        return a ?: false;
    }

    public function testShortTernaryComplex(var left, var value) -> var|boolean
    {
        return left ?: value;
    }
}
--USAGE--
$test = new \Stub\Ternary();
echo var_export($test->testTernary1(), true), "\n";
echo var_export($test->testTernary2(true), true), "\n";
echo var_export($test->testTernary2(false), true), "\n";
echo var_export($test->testTernaryAfterLetVariable(), true), "\n";
echo var_export($test->testTernaryWithPromotedTemporaryVariable(), true), "\n";
echo var_export($test->testShortTernary(true), true), "\n";
echo var_export($test->testShortTernary([]), true), "\n";
echo var_export($test->testShortTernary([1, 2, 3]), true), "\n";
echo var_export($test->testShortTernary(false), true), "\n";
echo var_export($test->testShortTernary(0), true), "\n";
echo var_export($test->testShortTernaryComplex(false, 1), true), "\n";
echo var_export($test->testShortTernaryComplex(false, 'test string'), true), "\n";
echo var_export($test->testShortTernaryComplex(false, []), true), "\n";
echo var_export($test->testTernaryComplex1([], ''), true), "\n";
echo var_export($test->testTernaryComplex2([], ''), true), "\n";
echo var_export($test->testTernaryComplex3(''), true), "\n";
--EXPECT--
101
'foo'
'bar'
3
array (
  0 => '',
  1 => 'c',
  2 => '',
)
true
false
array (
  0 => 1,
  1 => 2,
  2 => 3,
)
false
false
1
'test string'
array (
)
101
106
'boolean'
