--TEST--
Concat: static-property concat, string append/prepend, integer-like strings (#1573), float/double concat (#1893), integer operand on a `string` and on a `var` (#2660), double/bool/null operand on a `string`, a `var`, an object property, a static property and the `.` operator (#2664) (port of tests/Extension/ConcatTest.php)
--FILE--
namespace Stub;

class Concat
{
    protected static testProperty = null;

    protected static appended = "";

    protected store = "";

    static public function getTestProperty() -> string | null
    {
        return self::testProperty;
    }

    static public function testConcatBySelfProperty(string title) -> void
    {
        let self::testProperty .= title;
    }

    public function testConcat1() -> string
    {
        var url;
        let url = "test";
        let url = "append" . url;
        return url;
    }

    public function testConcat2() -> string
    {
        var url;
        let url = "test";
        let url = "append" . url . "other";
        let url = "append" . "other";
        let url = "append" . "other" . url;
        return url;
    }

    public function testConcat3() -> string
    {
        var a, b;
        let a = "1";
        let b = "2";
        let b .= a;
        return b;
    }

    public function testConcat4(var value) -> string
    {
        var min, max;
        string query = "";

        let min = value / 100 * 25,
            max = value / 100 * 50;

        let query .= "SELECT * FROM TEST WHERE value <= " . max,
            query .= " AND value >= " . min;

        return query;
    }

    public function testConcat5(double number) -> string
    {
        string retval;
        string left = "Concatenated string with number ";

        let retval = left . number;

        return retval;
    }

    public function testConcatStringWithIntVar(int number) -> string
    {
        string retval = "n=";
        let retval .= number;
        return retval;
    }

    public function testConcatStringWithLongVar() -> string
    {
        string retval = "n=";
        long number = 2147483647;
        let retval .= number;
        return retval;
    }

    public function testConcatStringWithUintVar() -> string
    {
        string retval = "n=";
        uint number = 5;
        let retval .= number;
        return retval;
    }

    public function testConcatStringWithUlongVar() -> string
    {
        string retval = "n=";
        ulong number = 5;
        let retval .= number;
        return retval;
    }

    public function testConcatStringWithCharVar() -> string
    {
        string retval = "n=";
        char c = 'A';
        let retval .= c;
        return retval;
    }

    public function testConcatVarWithIntVar(int number) -> string
    {
        var retval = "n=";
        let retval .= number;
        return retval;
    }

    public function testConcatVarWithCharVar() -> string
    {
        var retval = "n=";
        char c = 'A';
        let retval .= c;
        return retval;
    }

    public function testConcatVarWithIntLiteral() -> string
    {
        var retval = "n=";
        let retval .= 5;
        return retval;
    }

    public function testConcatStringWithDoubleVar(double number) -> string
    {
        string retval = "n=";
        let retval .= number;
        return retval;
    }

    public function testConcatStringWithBoolVar(bool flag) -> string
    {
        string retval = "n=";
        let retval .= flag;
        return retval;
    }

    public function testConcatStringWithLiterals() -> string
    {
        string retval = "n=";
        let retval .= 1.5;
        let retval .= true;
        let retval .= false;
        let retval .= null;
        return retval;
    }

    public function testConcatVarWithLiterals() -> string
    {
        var retval = "n=";
        let retval .= 1.5;
        let retval .= true;
        let retval .= false;
        let retval .= null;
        return retval;
    }

    public function testConcatIntVarWithFalseLiteral() -> string
    {
        var retval = 5;
        let retval .= false;
        return retval;
    }

    public function getStore() -> string
    {
        return this->store;
    }

    public function appendPropertyLiterals() -> void
    {
        let this->store .= "s";
        let this->store .= 5;
        let this->store .= 1.5;
        let this->store .= true;
    }

    public function appendPropertyVariables(int number, double fraction, bool flag) -> void
    {
        char c = 'A';

        let this->store .= number;
        let this->store .= fraction;
        let this->store .= flag;
        let this->store .= c;
    }

    static public function getAppended() -> string
    {
        return self::appended;
    }

    static public function appendStaticLiterals() -> void
    {
        let self::appended .= "s";
        let self::appended .= 5;
        let self::appended .= 1.5;
        let self::appended .= true;
    }

    public function testConcatExprWithBoolVar(bool flag) -> string
    {
        return "n=" . flag;
    }

    public function testConcatExprWithCharVar() -> string
    {
        char c = 'A';
        return "n=" . c;
    }
}
--USAGE--
$test = new \Stub\Concat();
echo var_export($test->getTestProperty(), true), "\n";
$test->testConcatBySelfProperty('test');
echo var_export($test->getTestProperty(), true), "\n";
$test->testConcatBySelfProperty(' string');
echo var_export($test->getTestProperty(), true), "\n";
echo var_export($test->testConcat1(), true), "\n";
echo var_export($test->testConcat2(), true), "\n";
echo var_export($test->testConcat3(), true), "\n";
echo var_export($test->testConcat4(1893), true), "\n";
echo var_export($test->testConcat5(18.93000001), true), "\n";
echo var_export($test->testConcatStringWithIntVar(5), true), "\n";
echo var_export($test->testConcatStringWithIntVar(-5), true), "\n";
echo var_export($test->testConcatStringWithIntVar(PHP_INT_MIN), true), "\n";
echo var_export($test->testConcatStringWithLongVar(), true), "\n";
echo var_export($test->testConcatStringWithUintVar(), true), "\n";
echo var_export($test->testConcatStringWithUlongVar(), true), "\n";
echo var_export($test->testConcatStringWithCharVar(), true), "\n";
echo var_export($test->testConcatVarWithIntVar(-5), true), "\n";
echo var_export($test->testConcatVarWithCharVar(), true), "\n";
echo var_export($test->testConcatVarWithIntLiteral(), true), "\n";
echo var_export($test->testConcatStringWithDoubleVar(1.5), true), "\n";
echo var_export($test->testConcatStringWithBoolVar(true), true), "\n";
echo var_export($test->testConcatStringWithBoolVar(false), true), "\n";
echo var_export($test->testConcatStringWithLiterals(), true), "\n";
echo var_export($test->testConcatVarWithLiterals(), true), "\n";
echo var_export($test->testConcatIntVarWithFalseLiteral(), true), "\n";
$test->appendPropertyLiterals();
$test->appendPropertyVariables(5, 1.5, true);
echo var_export($test->getStore(), true), "\n";
\Stub\Concat::appendStaticLiterals();
echo var_export(\Stub\Concat::getAppended(), true), "\n";
echo var_export($test->testConcatExprWithBoolVar(true), true), "\n";
echo var_export($test->testConcatExprWithBoolVar(false), true), "\n";
echo var_export($test->testConcatExprWithCharVar(), true), "\n";
