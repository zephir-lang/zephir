--TEST--
Function calls: internal fns, dynamic {var}(), func_get_args/arg, array_fill, namespaced + global function declarations with type casting (port of tests/Extension/FcallTest.php)
--FILE--
namespace Stub\Oo;

class PropertyAccess
{
    protected a;

    protected b;

    private privateVariable;

    public function __construct()
    {
        var test, test1;
        let test = new \stdClass;
        let test->test = ["1", 2, 3, 5, 6.00];
        let test->test2 = test->test[0];
        let test->test3 = test->test[1];
        let test->test3 = [test->test[1], 1, 2, 3];

        let this->a = test;
        let this->b = this->a->test2;

        let test1 = this->a;
    }
}
--FILE--
function zephir_global_method_test(var str)
{
	return new Fcall()->testStrtokVarBySlash(str);
}

function zephir_global_method_with_type_casting(<\stdClass> variable)
{
	return variable;
}

namespace Stub;

use Stub\Oo\PropertyAccess;

function zephir_namespaced_method_test(var str)
{
	return new Fcall()->testCall5(str, 5);
}

function test_call_relative_object_hint(<PropertyAccess> a) -> boolean
{
	return true;
}

function zephir_namespaced_method_with_type_casting(<\stdClass> variable)
{
	return variable;
}

function test_call_object_hint(<\Stub\Oo\PropertyAccess> a) -> boolean
{
	return true;
}

class Fcall
{
	public function testCall1() -> int
	{
		return strpos("hello", "h");
	}

	public function testCall2() -> int
	{
		loop {
			return mt_rand(0, 100);
		}
	}

	public function testCall5(var a, var b)
	{
		return str_repeat(a, b);
	}

	public function testCall1FromVar() -> int
	{
		var funcName;
		let funcName = "strpos";
		return {funcName}("hello", "l");
	}

	public function testStrtokFalse() -> bool
	{
		return strtok("/");
	}

	public function testStrtokVarBySlash(var value) -> string
	{
		return strtok(value, "/");
	}

	public function testFunctionGetArgs(var param1, var param2) -> array
	{
		return func_get_args();
	}

	public function testFunctionGetArgsAllExtra() -> array
	{
		return func_get_args();
	}

	public static function testStaticFunctionGetArgsAllExtra() -> array
	{
		return func_get_args();
	}

	public function testFunctionGetArgAllExtra() -> array
	{
		return [func_get_arg(0), func_get_arg(1)];
	}

	public static function testStaticFunctionGetArgAllExtra() -> array
	{
		return [func_get_arg(0), func_get_arg(1)];
	}

	public function testArrayFill() -> array
	{
		var v1, v2;
		let v1 = array_fill(0, 5, "?");
		let v2 = array_fill(0, 6, "?");
		return [v1, v2];
	}
}
--USAGE--
use Stub\Fcall;
use Stub\Oo\PropertyAccess;

use function Stub\test_call_object_hint;
use function Stub\test_call_relative_object_hint;
use function Stub\zephir_namespaced_method_test;
use function Stub\zephir_namespaced_method_with_type_casting;

$test = new Fcall();

// internal fns
echo var_export($test->testCall1(), true), "\n";          // strpos hello,h -> 0
echo var_export($test->testCall2() > -1, true), "\n";     // mt_rand(0,100) > -1
echo var_export($test->testCall1FromVar(), true), "\n";   // {"strpos"}(hello,l) -> 2

// strtok
echo var_export($test->testStrtokFalse(), true), "\n";
echo var_export($test->testStrtokVarBySlash('test'), true), "\n";

// func_get_args / func_get_arg over dataProvider rows
$rows = [
    [true, false],
    [1025, false],
    [false, 1234],
    [[1, 2, 3], false],
];
foreach ($rows as $r) {
    var_export($test->testFunctionGetArgs($r[0], $r[1])); echo "\n";
}
foreach ($rows as $r) {
    var_export($test->testFunctionGetArgsAllExtra($r[0], $r[1])); echo "\n";
}
foreach ($rows as $r) {
    var_export(Fcall::testStaticFunctionGetArgsAllExtra($r[0], $r[1])); echo "\n";
}
var_export($test->testFunctionGetArgAllExtra(true, false)); echo "\n";
var_export(Fcall::testStaticFunctionGetArgAllExtra(true, false)); echo "\n";

// array_fill
var_export($test->testArrayFill()); echo "\n";

// namespaced + global function declarations
echo var_export(zephir_namespaced_method_test('a'), true), "\n";  // str_repeat('a',5)
echo var_export(test_call_relative_object_hint(new PropertyAccess()), true), "\n";
echo var_export(test_call_object_hint(new PropertyAccess()), true), "\n";
echo var_export(zephir_global_method_test('ab/c'), true), "\n";   // strtok('ab/c','/') -> 'ab'
echo var_export(zephir_namespaced_method_with_type_casting(new \stdClass()) instanceof \stdClass, true), "\n";
echo var_export(zephir_global_method_with_type_casting(new \stdClass()) instanceof \stdClass, true), "\n";
