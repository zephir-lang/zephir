--TEST--
typeof operator on native types, arrays, properties, callables and unknown values (port of tests/Extension/TypeoffTest.php)
--FILE--
namespace Stub;

class Typeoff
{
    protected property;

	public function testNativeStringFalse()
	{
		string testVar;
		let testVar = "sdfsdf";

		return typeof testVar == "object";
	}

	public function testNativeStringTrue()
	{
		string testVar;
		let testVar = "sdfsdf";

		return typeof testVar == "string";
	}

	public function testNativeIntFalse()
	{
		int testVar;
		let testVar = 12345;

		return typeof testVar == "object";
	}

	public function testNativeIntTrue()
	{
		int testVar;
		let testVar = 12345;

		return typeof testVar == "integer";
	}

	public function testNativeDoubleTrue()
	{
		double testVar;
		let testVar = 12345;

		return typeof testVar == "double";
	}

	public function testNativeBoolTrue()
	{
		bool testVar;
		let testVar = true;

		return typeof testVar == "boolean";
	}

	public function testNotBoolTrue()
	{
		// force usage of a zval
		var testVar = "";
		let testVar = true;

		return typeof testVar != "boolean";
	}

	public function testNativeBoolFalse()
	{
		bool testVar;
		let testVar = false;

		return typeof testVar == "double";
	}

	public function testArrayFalse()
	{
		var testVar;
		let testVar = [];

		return typeof testVar == "string";
	}

	public function testArrayTrue()
	{
		var testVar;
		let testVar = [];

		return typeof testVar == "array";
	}

	public function testClassPropertyAccess()
	{
	    let this->property = "test string";
		return typeof this->property == "string";
	}

	public function testUnknownTypeOf(var u)
	{
		return typeof u;
	}

	public function testCallableTypeOf(var cb)
	{
	    return typeof cb == "callable";
	}
}
--USAGE--
$test = new \Stub\Typeoff();

echo var_export($test->testNativeStringFalse(), true), "\n";
echo var_export($test->testNativeStringTrue(), true), "\n";
echo var_export($test->testNativeIntFalse(), true), "\n";
echo var_export($test->testNativeIntTrue(), true), "\n";
echo var_export($test->testNativeDoubleTrue(), true), "\n";
echo var_export($test->testNativeBoolFalse(), true), "\n";
echo var_export($test->testNativeBoolTrue(), true), "\n";
echo var_export($test->testNotBoolTrue(), true), "\n";
echo var_export($test->testArrayFalse(), true), "\n";
echo var_export($test->testArrayTrue(), true), "\n";
echo var_export($test->testClassPropertyAccess(), true), "\n";

$callback = function (): void {};
echo var_export($test->testCallableTypeOf($callback), true), "\n";
echo var_export($test->testCallableTypeOf(true), true), "\n";

echo var_export($test->testUnknownTypeOf('test'), true), "\n";
echo var_export($test->testUnknownTypeOf(5), true), "\n";
echo var_export($test->testUnknownTypeOf(true), true), "\n";
echo var_export($test->testUnknownTypeOf(5.5), true), "\n";
echo var_export($test->testUnknownTypeOf([]), true), "\n";
echo var_export($test->testUnknownTypeOf(new \stdClass()), true), "\n";
echo var_export($test->testUnknownTypeOf(null), true), "\n";
--EXPECT--
false
true
false
true
true
false
true
false
false
true
true
true
false
'string'
'integer'
'boolean'
'double'
'array'
'object'
'NULL'
