function outcome(callable $call): string
{
    $diagnostics = [];
    set_error_handler(function ($no, $message) use (&$diagnostics) {
        $diagnostics[] = $message;

        return true;
    });
    ob_start();
    try {
        $result = 'ok ' . var_export($call(), true);
    } catch (\Throwable $e) {
        $result = get_class($e) . ': ' . $e->getMessage();
    } finally {
        restore_error_handler();
    }

    return $result . ' | echoed=' . ob_get_clean() . ' | diag=' . implode(';', $diagnostics);
}

/**
 * A diagnostic turned into an exception must stop the operation, as in PHP.
 */
function outcomeThrowing(callable $call): string
{
    set_error_handler(function ($no, $message) {
        throw new \ErrorException($message, 0, $no);
    });
    ob_start();
    try {
        $result = 'ok ' . var_export($call(), true);
    } catch (\Throwable $e) {
        $result = get_class($e) . ': ' . $e->getMessage();
    } finally {
        restore_error_handler();
    }

    return $result . ' | echoed=' . ob_get_clean();
}

function invoke(string $class, string $method, array $args)
{
    if ((new \ReflectionMethod($class, $method))->isStatic()) {
        return $class::$method(...$args);
    }

    return (new $class())->$method(...$args);
}

$longs   = [5, -8];
$counts  = [0, 1, 3, 40, 63, 64, -1];
$vars    = [1, 3, 40, 64, -1, '5', '5abc', 'abc', '1.5', '', [1], null, true, false, 2.5, 1e20, new \stdClass()];
$doubles = [2.0, 2.5, -2.5, 5e9, 1e20, INF, NAN];
$props   = [3, 'abc', 2.5, [1], '5', null];

$pairs = function (array $left, array $right): array {
    $pairs = [];
    foreach ($left as $a) {
        foreach ($right as $b) {
            $pairs[] = [$a, $b];
        }
    }

    return $pairs;
};
$singles = fn (array $values): array => array_map(fn ($value) => [$value], $values);

$plan = [];
foreach (['and', 'or', 'xor', 'shl', 'shr'] as $op) {
    $plan[$op . 'LongVar']      = $pairs($longs, $vars);
    $plan[$op . 'VarLong']      = $pairs($vars, [1, 3]);
    $plan[$op . 'DoubleLong']   = $pairs($doubles, [1, 3]);
    $plan[$op . 'LongDouble']   = $pairs($longs, [2.0, -2.0, 2.5, 5e9, 1e20, NAN]);
    $plan[$op . 'DoubleDouble'] = [[2.0, 3.0], [2.5, 1.0], [5e9, 1.0], [1e20, 2.0]];
    $plan[$op . 'BoolLong']     = $pairs([0, 1], [3, 4, 40]);
    $plan[$op . 'BoolLit']      = $singles([0, 1]);
    $plan[$op . 'LongBool']     = $pairs($longs, [0, 1]);
    $plan[$op . 'VarBool']      = $pairs($vars, [true, false]);
    $plan[$op . 'BoolVar']      = $pairs([true, false], $vars);
    $plan[$op . 'DoubleVar']    = $pairs([2.0, 2.5], $vars);
    $plan[$op . 'VarVar']       = [['ab', '  '], ['12', '3'], [5, 'abc'], ['5', 2.5], [[1], 1], [5, 40]];
    $plan[$op . 'StrLit']       = $singles($vars);
    $plan[$op . 'NullLit']      = $singles($vars);
    $plan[$op . 'MixedLong']    = $pairs($vars, [1]);
    $plan[$op . 'StringLong']   = $pairs(['5', '5abc', 'abc', '', '1.5', '12'], [1, 3]);
    $plan[$op . 'LongTrue']     = $singles($longs);
    $plan[$op . 'LongTwo']      = $singles($longs);
    $plan[$op . 'LongTwoHalf']  = $singles($longs);
    $plan[$op . 'HalfDouble']   = $singles([1.5, 2.0]);
    $plan[$op . 'FoldHalf']     = [[]];
    $plan[$op . 'InferBool']    = [[]];
    $plan[$op . 'InferBoolExpr'] = $singles([0, 1, 2]);
    $plan[$op . 'InferDouble']  = [[]];
    $plan[$op . 'CompoundLong'] = $pairs([5], $vars);
    $plan[$op . 'CompoundHalf'] = [[5]];
    $plan[$op . 'Prop']         = $singles($props);
    $plan[$op . 'PropKeep']     = $singles($props);
    $plan[$op . 'Static']       = $singles($props);
}
$plan['notLong']     = $singles([5, -8, 0, PHP_INT_MAX, PHP_INT_MIN]);
$plan['notDouble']   = $singles($doubles);
$plan['notBool']     = $singles([true, false]);
$plan['notVar']      = $singles($vars);
$plan['notMixed']    = $singles($vars);
$plan['notString']   = $singles(['ab', '', '5']);
$plan['notVarLocal'] = $singles($vars);
$plan['notInfer']    = $singles([5, -1]);
$plan['shlInt']      = $singles($counts);
$plan['shlVarCount'] = $singles(array_merge($counts, $vars));
$plan['foldMin']     = [[]];

$throwing = ['notDouble' => [[2.5], [1e20]]];
foreach (['and', 'or', 'xor', 'shl', 'shr'] as $op) {
    $throwing[$op . 'DoubleLong']   = [[2.5, 1]];
    $throwing[$op . 'LongDouble']   = [[5, 2.5]];
    $throwing[$op . 'DoubleVar']    = [[2.5, 1]];
    $throwing[$op . 'VarLong']      = [['5abc', 1], [2.5, 1]];
    $throwing[$op . 'LongTwoHalf']  = [[5]];
    $throwing[$op . 'FoldHalf']     = [[]];
    $throwing[$op . 'CompoundHalf'] = [[5]];
    $throwing[$op . 'Prop']         = [[2.5]];
    $throwing[$op . 'PropKeep']     = [[2.5]];
    $throwing[$op . 'Static']       = [[2.5]];
}

$cases = 0;
$diffs = 0;
foreach ([[$plan, 'outcome'], [$throwing, 'outcomeThrowing']] as [$table, $runner]) {
    foreach ($table as $method => $argsList) {
        if (!method_exists(BitwiseParity::class, $method)) {
            continue;
        }
        foreach ($argsList as $args) {
            $cases++;
            $zephir = $runner(fn () => invoke(BitwiseParity::class, $method, $args));
            $php    = $runner(fn () => invoke(PhpBitwiseParity::class, $method, $args));
            if ($zephir !== $php) {
                $diffs++;
                echo $runner, ' ', $method, '(', json_encode($args, JSON_PARTIAL_OUTPUT_ON_ERROR), "): DIFF\n  zephir: $zephir\n  php:    $php\n";
            }
        }
    }
}
echo $cases, " cases, $diffs diffs\n";
--EXPECT--
1814 cases, 0 diffs
