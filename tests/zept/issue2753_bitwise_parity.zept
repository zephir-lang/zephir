        echo "after";

        return r;
    }

    public static function notString(string a)
    {
        var r;

        let r = ~a;
        echo "after";

        return r;
    }

    public static function notVarLocal(var a)
    {
        var x, r;

        let x = a;
        let r = ~x;
        echo "after";

        return r;
    }

    public static function notInfer(long i)
    {
        var x;

        let x = ~i;

        return x;
    }

    public static function shlInt(int n)
    {
        return 1 << n;
    }

    public static function shlVarCount(var n)
    {
        return 1 << n;
    }

    public static function foldMin()
    {
        return 1 << 63;
    }
}
