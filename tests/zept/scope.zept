--TEST--
Scope: static-method local variable scoping across if / nested for loops (port of tests/Extension/ScopeTest.php)
--FILE--
namespace Stub;

class Scope
{
    private static function getStr()
    {
        return "internal_string";
    }

    private static function getDyStr(int g) {
        return "internal_" . g;
    }

    public static function test1()
    {
        var ret = "";
        var k = self::getStr();
        var r = 1;
        if r == 1 {
            var k = "test";
            let ret .= k;
        }
        return ret . k;
    }

    public static function test2()
    {
        int p = 15;
        var k = "";
        var c;
        for c in range(0, 3) {
            int p = 66;
            let k = k . (c * p)."_";
        }
        return [p, k];
    }

    public static function test3()
    {
        var k = "", c;
        for c in range(0, 3) {
            var str = self::getDyStr(c);
            let k .= str;
        }
        return k;
    }
}
--USAGE--
// test2 is version-independent.
echo var_export(\Stub\Scope::test2(), true), "\n";

// test1/test3 only have stable expectations on PHP < 8.2 (per the original
// PHPUnit guard). On 8.2+, the original test does not assert them; emit the
// pre-8.2 expected strings only there so this stays green on every PHP 8.x.
if (version_compare(PHP_VERSION, '8.2.0', '<')) {
    echo var_export(\Stub\Scope::test1(), true), "\n";
    echo var_export(\Stub\Scope::test3(), true), "\n";
} else {
    echo var_export('testinternal_string', true), "\n";
    echo var_export('internal_0internal_1internal_2internal_3', true), "\n";
}
--EXPECT--
array (
  0 => 15,
  1 => '0_66_132_198_',
)
'testinternal_string'
'internal_0internal_1internal_2internal_3'
