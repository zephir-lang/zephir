echo var_export($test->testMultipleArrayUpdate9(), true), "\n";
echo var_export($test->testMultipleArrayUpdate10(), true), "\n";
echo var_export($test->testMultipleArrayUpdate11(), true), "\n";
echo var_export($test->testMultipleArrayUpdate12(), true), "\n";

// testArrayKeys
echo var_export($test->testArrayKeys(['test1' => 1, 'test2' => 2, 'test3' => 3]), true), "\n";
echo var_export($test->testArrayKeys([1, 2, 3, 4, 5, 6]), true), "\n";

// testImplodeArray
echo var_export($test->testImplodeArray(['test1' => 1, 'test2' => 2, 'test3' => 3]), true), "\n";

// testIssue110
echo var_export($test->issue110(), true), "\n";

// testIssue264
echo var_export($test->issue264([1, 2, 3]), true), "\n";

// testIssue743
echo var_export($test->issue743a([42 => []]), true), "\n";
echo var_export($test->issue743b(['str' => []]), true), "\n";
echo var_export($test->issue743c(['str' => []]), true), "\n";

// testIssue709
echo var_export($test->issue709(), true), "\n";

// testIssue1140
echo var_export($test->Issue1140('phalcon', '/var/www/html/phalcon'), true), "\n";

// testIssue1159
echo var_export($test->Issue1159(), true), "\n";
