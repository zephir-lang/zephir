--TEST--
ArrayAccess: isset/get on a Zephir ArrayAccess, unset by key from array/property, and issues #1877/#645/#1155/#1094/#1259 (port of tests/Extension/ArrayAccessTest.php)
--FILE--
namespace Stub;

class ArrayAccessArr implements \ArrayAccess
{
	protected test;

	public function __construct()
	{
		let this->test = [
			"one":1,
			"two":2,
			"three":3
		];
	}

	public function offsetSet(mixed offset, mixed value) -> void
	{
		if is_null(offset) {
			let this->test[] = value;
		} else {
			let this->test[offset] = value;
		}
	}

	public function offsetExists(mixed offset) -> bool
	{
		return isset this->test[offset];
	}

	public function offsetUnset(mixed offset) -> void
	{
		unset this->test[offset];
	}

	public function offsetGet(mixed offset) -> mixed
	{
		return isset this->test[offset] ? this->test[offset] : null;
	}
}
--FILE--
namespace Stub;

class ArrayAccessTest
{
    protected data;
    protected assigedFromMethod;
    protected unsetData = [
        "key_a": "marcin",
        "key_b": "paula",
        3: "long value"
    ];

	public static function exits()
	{
		var arr;

		let arr = new ArrayAccessArr();
		return isset arr["one"];
	}

	public static function get()
	{
		var arr;

		let arr = new ArrayAccessArr();
		return arr["two"];
	}

	public function unsetByKeyFromArray(string! key, array data) -> array
	{
	    unset data[key];

	    return data;
	}

	public function unsetByKeyFromProperty(string! key, array dataFromProperty) -> array
	{
	    let this->assigedFromMethod = dataFromProperty;

	    unset this->assigedFromMethod[key];

	    return this->assigedFromMethod;
	}

    public function issue645() -> array
    {
        let this->{"data"} = [];

        return this->{"data"};
    }

    public function issue1877() -> string
    {
        var config, conf;

        let config = ["aaa": "bbb"];
        let conf   = config["aaa"];

        return conf;
    }

    public function issue1155() -> bool
    {
        array arr;
        var s;

        let arr = ["0", "false", ""];
        let s = "true";

        return in_array(s, arr);
    }

    public function issue1094Test1(const array items = null) -> bool
    {
        bool isItemsNULL;

        return isItemsNULL;
    }

    public function issue1094Test2(const array items = null) -> bool
    {
        bool isItemsNULL;

        let isItemsNULL = items === null;

        return isItemsNULL;
    }

    public function issue1094Test3(const array items = null) -> bool
    {
        bool isItemsNULL;

        let isItemsNULL = is_null(items);

        return isItemsNULL;
    }

    public function issue1259UnsetKeyFromArrayInternalVariable() -> array
    {
        array ret = [];
        array unsetData = ["key_a": "marcin", "key_b": "paula"];

        let ret[] = unsetData;
        unset(unsetData["key_a"]);
        let ret[] = unsetData;

        return ret;
    }

    public function issue1259UnsetStringKeyFromArrayProperty() -> array
    {
        array ret = [];

        let ret[] = this->unsetData;
        unset(this->unsetData["key_a"]);
        let ret[] = this->unsetData;

        return ret;
    }

    public function issue1259UnsetLongKeyFromArrayProperty() -> array
    {
        array ret = [];

        let ret[] = this->unsetData;
        unset(this->unsetData[3]);
        let ret[] = this->unsetData;

        return ret;
    }
}
--USAGE--
$class = new \Stub\ArrayAccessTest();

// testTest
echo var_export($class->exits('one'), true), "\n";
echo var_export($class->get(), true), "\n";

// testIssue1877
echo var_export($class->issue1877(), true), "\n";

// testUnsetByKeyFromArray
echo var_export($class->unsetByKeyFromArray('not-exist', []), true), "\n";

// testUnsetByKeyFromProperty
echo var_export($class->unsetByKeyFromProperty('ok', ['ok' => true]), true), "\n";
echo var_export($class->unsetByKeyFromProperty('ok', ['ok' => true, 'another' => 'value']), true), "\n";
echo var_export($class->unsetByKeyFromProperty('not-exist', []), true), "\n";

// testIssue645
echo var_export($class->issue645(), true), "\n";

// testIssue1155
echo var_export($class->issue1155(), true), "\n";

// testIssue1094
echo var_export($class->issue1094Test1(), true), "\n";
echo var_export($class->issue1094Test1([]), true), "\n";
echo var_export($class->issue1094Test1(['test' => 'ok']), true), "\n";
echo var_export($class->issue1094Test2(), true), "\n";
echo var_export($class->issue1094Test2([]), true), "\n";
echo var_export($class->issue1094Test2(['test' => 'ok']), true), "\n";
echo var_export($class->issue1094Test3(), true), "\n";
echo var_export($class->issue1094Test3([]), true), "\n";
echo var_export($class->issue1094Test3(['test' => 'ok']), true), "\n";

// testIssue1259CheckUnsetKeyFromArray
echo var_export($class->issue1259UnsetKeyFromArrayInternalVariable(), true), "\n";

// testIssue1259CheckUnsetStringKeyFromArrayProperty
echo var_export($class->issue1259UnsetStringKeyFromArrayProperty(), true), "\n";

// testIssue1259CheckUnsetLongKeyFromArrayProperty (fresh instance: property mutated above)
$class2 = new \Stub\ArrayAccessTest();
echo var_export($class2->issue1259UnsetLongKeyFromArrayProperty(), true), "\n";
