--TEST--
Method calls: public/protected/private, dynamic name, optional params, typed array/object params (+Reflection), #1136 finfo, #2245 nullable (port of tests/Extension/MCallTest.php)
--FILE--
namespace Stub\Oo;

class Param
{
	public value;
}
--FILE--
namespace Stub;

class Mcall
{
	public function testMethod1()
	{
		return "hello public";
	}

	protected function testMethod2()
	{
		return "hello protected";
	}

	private function testMethod3()
	{
		return "hello private";
	}

	public function testMethod4(var a, var b)
	{
		return a + b;
	}

	protected function testMethod5(var a, var b)
	{
		return a + b;
	}

	private function testMethod6(var a, var b)
	{
		return a + b;
	}

	private function testMethod7() -> <\stdClass>
	{
		return new \stdClass();
	}

	public function testCall1()
	{
		return this->testMethod1();
	}

	public function testCall2()
	{
		return this->testMethod2();
	}

	public function testCall3()
	{
		return this->testMethod3();
	}

	public function testCall4(var a, var b)
	{
		return this->testMethod4(a, b);
	}

	public function testCall5(var a, var b)
	{
		return this->testMethod5(a, b);
	}

	public function testCall6(var a, var b)
	{
		return this->testMethod6(a, b);
	}

	public function testCall7(var a, var b)
	{
		return this->testMethod4(a, b) + this->testMethod4(a, b);
	}

	public function testCall8(var a, var b)
	{
		return this->testMethod5(a, b) + this->testMethod5(a, b);
	}

	public function testCall9(var a, var b)
	{
		return this->testMethod6(a, b) + this->testMethod5(a, b);
	}

	public function testCall10()
	{
		return this->{"testMethod1"}();
	}

	public function testCall11()
	{
		return this->{"testMethod2"}();
	}

	public function testCall12()
	{
		return this->{"testMethod3"}();
	}

	public function testCall13(var a, var b)
	{
		return this->{"testMethod4"}(a, b);
	}

	public function testCall14(var a, var b)
	{
		return this->{"testMethod5"}(a, b);
	}

	public function testCall15(var a, var b)
	{
		return this->{"testMethod6"}(a, b);
	}

	public function optionalParameterString(string param = "test string")
	{
		return param;
	}

	public function optionalParameterStringNull(string param = null)
	{
		return param;
	}

	public function optionalParameterInt(int param = 2)
	{
		return param;
	}

	public function optionalParameterVar(var param = null)
	{
		return param;
	}

	public function optionalParameterBoolTrue(bool param = true)
	{
		return param;
	}

	public function optionalParameterBoolFalse(bool param = false)
	{
		return param;
	}

	public function optionalParameterBoolean(boolean! start = true)
	{
		return start;
	}

	public function optionalParameterBooleanNull(bool! value = null)
	{
		return value;
	}

	/**
	 * @link https://github.com/zephir-lang/zephir/issues/142
	 */
	public function testArrayParamWithDefaultEmptyArray(array driverOptions = [])
	{
		return driverOptions;
	}

	public function testArrayParamWithDefaultNullValue(array driverOptions = null)
	{
		return driverOptions;
	}

	public function testArrayParam(array driverOptions)
	{
		return driverOptions;
	}

	public function testObjectParamCastStdClass(<\stdClass> param)
	{
		return param;
	}

	public function testObjectParamCastOoParam(<Oo\Param> param)
	{
		return param;
	}

    /**
     * @issue https://github.com/zephir-lang/zephir/issues/1136
     */
    public function issue1136()
    {
        var _finfo;

        if version_compare(PHP_VERSION, "8.0.0", ">=") {
            let _finfo = new \finfo();
        } else {
            let _finfo = finfo_open();
        }

        return _finfo;
    }

    public function issue2245VarArgumentNullable(var param = null)
    {
        return param;
    }
}
--USAGE--
use Stub\Mcall;
use Stub\Oo\Param;

$test = new Mcall();

// direct + via-this + dynamic-name visibility hops
echo var_export($test->testCall1(), true), "\n";
echo var_export($test->testCall2(), true), "\n";
echo var_export($test->testCall3(), true), "\n";
echo var_export($test->testCall4(2, 3), true), "\n";
echo var_export($test->testCall5(6, 7), true), "\n";
echo var_export($test->testCall6(4, 5), true), "\n";
echo var_export($test->testCall7(2, 3), true), "\n";
echo var_export($test->testCall8(6, 7), true), "\n";
echo var_export($test->testCall9(4, 5), true), "\n";
echo var_export($test->testCall10(), true), "\n";
echo var_export($test->testCall11(), true), "\n";
echo var_export($test->testCall12(), true), "\n";
echo var_export($test->testCall13(2, 3), true), "\n";
echo var_export($test->testCall14(6, 7), true), "\n";
echo var_export($test->testCall15(4, 5), true), "\n";

// optional params
echo var_export($test->optionalParameterString('test'), true), "\n";
echo var_export($test->optionalParameterString(), true), "\n";
echo var_export($test->optionalParameterStringNull(), true), "\n";
echo var_export($test->optionalParameterInt(1), true), "\n";
echo var_export($test->optionalParameterInt(), true), "\n";
echo var_export($test->optionalParameterVar(1), true), "\n";
echo var_export($test->optionalParameterVar('testtesttesttest'), true), "\n";
echo var_export($test->optionalParameterVar(), true), "\n";
echo var_export($test->optionalParameterBoolFalse(), true), "\n";
echo var_export($test->optionalParameterBoolTrue(), true), "\n";
echo var_export($test->optionalParameterBooleanNull(), true), "\n";
echo var_export($test->optionalParameterBooleanNull(true), true), "\n";
echo var_export($test->optionalParameterBoolean(), true), "\n";
echo var_export($test->optionalParameterBoolean(false), true), "\n";

// array/object typed params — runtime + Reflection arginfo (reproduces on ext)
$r = new \ReflectionClass(Mcall::class);
$m = $r->getMethod('testArrayParamWithDefaultEmptyArray');
echo var_export($m->getNumberOfParameters(), true), "\n";
echo var_export($m->getNumberOfRequiredParameters(), true), "\n";
echo var_export($m->getParameters()[0]->getType()->getName(), true), "\n";
var_export($test->testArrayParamWithDefaultEmptyArray()); echo "\n";
var_export($test->testArrayParamWithDefaultEmptyArray([1])); echo "\n";

$m = $r->getMethod('testArrayParamWithDefaultNullValue');
echo var_export($m->getNumberOfParameters(), true), "\n";
echo var_export($m->getNumberOfRequiredParameters(), true), "\n";
echo var_export($m->getParameters()[0]->getType()->getName(), true), "\n";
echo var_export($test->testArrayParamWithDefaultNullValue(), true), "\n";
var_export($test->testArrayParamWithDefaultNullValue([1])); echo "\n";

$m = $r->getMethod('testArrayParam');
echo var_export($m->getNumberOfParameters(), true), "\n";
echo var_export($m->getNumberOfRequiredParameters(), true), "\n";
echo var_export($m->getParameters()[0]->getType()->getName(), true), "\n";
var_export($test->testArrayParam([])); echo "\n";
var_export($test->testArrayParam([1, 2, 3])); echo "\n";

$m = $r->getMethod('testObjectParamCastStdClass');
echo var_export($m->getParameters()[0]->getType()->getName(), true), "\n";
echo var_export($test->testObjectParamCastStdClass(new \stdClass()) instanceof \stdClass, true), "\n";

$m = $r->getMethod('testObjectParamCastOoParam');
echo var_export($m->getParameters()[0]->getType()->getName(), true), "\n";
echo var_export($test->testObjectParamCastOoParam(new Param()) instanceof Param, true), "\n";

// A bad bool argument must throw. The original PHPUnit asserts \Error, but the
// throwaway ext distinguishes by arg type: a string raises Zephir's own
// InvalidArgumentException (extends \Exception) while an array hits a \TypeError
// (extends \Error). Both are version/build-sensitive, so we assert the portable
// invariant: something is thrown.
try {
    $test->optionalParameterBoolean('test');
    echo "no-throw\n";
} catch (\Throwable $e) {
    echo var_export($e instanceof \Throwable, true), "\n";
}
try {
    $test->optionalParameterBoolean([]);
    echo "no-throw\n";
} catch (\Throwable $e) {
    echo var_export($e instanceof \Throwable, true), "\n";
}

// #1136 finfo, #2245 nullable default
echo var_export($test->issue1136() instanceof \finfo, true), "\n";
echo var_export($test->issue2245VarArgumentNullable(), true), "\n";
