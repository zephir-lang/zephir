--TEST--
`<<` and `>>` behave as in PHP for every operand kind, including counts below 0 and above the integer width
--FILE--
namespace Stub;

class ShiftParity
{
    public static function varLeft(var a, var b)
    {
        var r;

        let r = a << b;
        echo "after";

        return r;
    }

    public static function varRight(var a, var b)
    {
        var r;

        let r = a >> b;
        echo "after";

        return r;
    }

    public static function nativeLeft(long a, long b)
    {
        long r;

        let r = a << b;
        echo "after";

        return r;
    }

    public static function nativeRight(long a, long b)
    {
        long r;

        let r = a >> b;
        echo "after";

        return r;
    }

    public static function returnedLeft(long a, long b) -> long
    {
        return a << b;
    }

    public static function mixedLeft(var a, long b)
    {
        var r;

        let r = a << b;
        echo "after";

        return r;
    }

    public static function literalWide(long a)
    {
        return [a << 64, a >> 70, a << 3];
    }

    public static function literalNegative(long a)
    {
        return a << -1;
    }

    public static function foldedNegative()
    {
        return 1 << -1;
    }

    public static function foldedWide()
    {
        return [1 << 64, -8 >> 64];
    }

    public static function shiftAssign(var a, var b)
    {
        let a <<= b;
        echo "after";

        return a;
    }
}
--USAGE--
use Stub\ShiftParity;

class PhpShiftParity
{
    public static function varLeft($a, $b) { $r = $a << $b; echo 'after'; return $r; }
    public static function varRight($a, $b) { $r = $a >> $b; echo 'after'; return $r; }
    public static function nativeLeft(int $a, int $b) { $r = $a << $b; echo 'after'; return $r; }
    public static function nativeRight(int $a, int $b) { $r = $a >> $b; echo 'after'; return $r; }
    public static function returnedLeft(int $a, int $b): int { return $a << $b; }
    public static function mixedLeft($a, int $b) { $r = $a << $b; echo 'after'; return $r; }
    public static function literalWide(int $a) { return [$a << 64, $a >> 70, $a << 3]; }
    public static function literalNegative(int $a) { $minusOne = -1; return $a << $minusOne; }
    public static function foldedNegative() { $one = 1; $minusOne = -1; return $one << $minusOne; }
    public static function foldedWide() { return [1 << 64, -8 >> 64]; }
    public static function shiftAssign($a, $b) { $a <<= $b; echo 'after'; return $a; }
}

function outcome(callable $call): string
{
    $diagnostics = [];
    set_error_handler(function ($no, $message) use (&$diagnostics) {
        $diagnostics[] = $message;

        return true;
    });
    ob_start();
    try {
        $result = 'ok ' . var_export($call(), true);
    } catch (\Throwable $e) {
        $result = get_class($e) . ': ' . $e->getMessage();
    } finally {
        restore_error_handler();
    }

    return $result . ' | echoed=' . ob_get_clean() . ' | diag=' . implode(';', $diagnostics);
}

$cases = [];
foreach ([[1, 3], [1, 0], [1, 63], [1, 64], [1, 100], [1, -1], [-8, 1], [-8, 64], ['5', 2], [[1], 1], [1, 'x']] as $args) {
    $cases[] = ['varLeft', $args];
    $cases[] = ['varRight', $args];
    $cases[] = ['shiftAssign', $args];
}
foreach ([[1, 3], [1, 0], [1, 63], [1, 64], [1, 100], [1, -1], [-8, 1], [-8, 64], [-8, 100], [-8, -1], [PHP_INT_MAX, 1]] as $args) {
    $cases[] = ['nativeLeft', $args];
    $cases[] = ['nativeRight', $args];
    $cases[] = ['returnedLeft', $args];
}
foreach ([['5', 2], [1.0, 3], [true, 2], [null, 1], ['5', 64], [2, -1]] as $args) {
    $cases[] = ['mixedLeft', $args];
}
foreach ([[1], [-8]] as $args) {
    $cases[] = ['literalWide', $args];
    $cases[] = ['literalNegative', $args];
}
$cases[] = ['foldedNegative', []];
$cases[] = ['foldedWide', []];

$diffs = 0;
foreach ($cases as [$method, $args]) {
    $zephir = outcome(fn () => ShiftParity::$method(...$args));
    $php    = outcome(fn () => PhpShiftParity::$method(...$args));
    if ($zephir !== $php) {
        $diffs++;
        echo $method, '(', json_encode($args), "): DIFF\n  zephir: $zephir\n  php:    $php\n";
    }
}
echo count($cases), " cases, $diffs diffs\n";
--EXPECT--
78 cases, 0 diffs
