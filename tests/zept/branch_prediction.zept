--TEST--
Branch prediction hints (if likely / if unlikely) do not change control flow (port of tests/Extension/BranchPredictionTest.php)
--FILE--
namespace Stub;

class BranchPrediction
{
	public function testLikely1()
	{
		if likely 1 == 1 {
			return true;
		} else {
			return false;
		}
	}

	public function testLikely2(var a)
	{
		if likely a === 1 {
			return true;
		} else {
			return false;
		}
	}

	public function testUnlikely1()
	{
		if likely 1 == 1 {
			return true;
		} else {
			return false;
		}
	}

	public function testUnlikely2(var a)
	{
		if likely a === 1 {
			return true;
		} else {
			return false;
		}
	}
}
--USAGE--
$br = new \Stub\BranchPrediction();
echo var_export($br->testLikely1(), true), "\n";
echo var_export($br->testLikely2(false), true), "\n";
echo var_export($br->testUnlikely1(), true), "\n";
echo var_export($br->testUnlikely2(false), true), "\n";
--EXPECT--
true
false
true
false
