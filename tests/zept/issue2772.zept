--TEST--
Issue #2772: assigning a local declared in a nested block writes that local, as PHP does
--FILE--
namespace Stub;

class Issue2772
{
	public function issue(array variables) -> array
	{
		var name, options, out = [];

		for name, options in variables {
			var clearValue = false;

			if isset options["name"] {
				let clearValue = true;
			}

			let out[name] = clearValue;
		}

		return out;
	}

	public function natives(var value) -> array
	{
		var out = [];

		if true {
			int i = 1, other = 10;
			uint u = 2;
			long l = 3;
			ulong ul = 4;
			double d = 1.5, half = 0.5;
			bool b = false, flag = false;
			char c = 'a';
			uchar uc = 'b';

			let i = 7;
			let i += 3;
			let i -= 1;
			let i *= 2;
			let i += other;
			let u = value;
			let u += 1;
			let l = half;
			let l += other;
			let ul = other;
			let ul *= 3;
			let d = 2;
			let d -= half;
			let d += other;
			let d *= value;
			let b = other;
			let flag = value;
			let c = 'z';
			let uc = c;

			let out = [i, u, l, ul, d, b, flag, c, uc];
		}

		return out;
	}

	public function shadowed() -> array
	{
		int n = 1;
		double d = 1.5;
		bool b = true;
		string s = "o";
		var inner = [];

		if true {
			int n = 5;
			double d = 2.5;
			bool b = false;
			string s = "i";

			let n += 1;
			let d *= 2;
			let b = true;
			let s .= "x";

			let inner = [n, d, b, s];
		}

		return [n, d, b, s, inner];
	}

	public function incrementDecrement() -> array
	{
		int n = 0;
		var inner = [];

		if true {
			int n = 10;
			double d = 0.5;

			let n++;
			let n++;
			let n--;
			let d++;

			let inner = [n, d];
		}

		return [n, inner];
	}

	public function concat(var value, int number, double real, bool yes) -> array
	{
		string s = "o";
		var inner = "";

		if true {
			string s = "i";
			char ch = 'c';

			let s .= "x";
			let s .= 5;
			let s .= 1.5;
			let s .= true;
			let s .= null;
			let s .= number;
			let s .= ch;
			let s .= real;
			let s .= yes;
			let s .= value;
			let s = s;

			let inner = s;
		}

		return [s, inner];
	}

	public function rangeLoop() -> array
	{
		var out = [];

		if true {
			int i;

			for i in range(1, 3) {
				let out[] = i;
			}
		}

		return out;
	}

	public function destructure(array pair) -> array
	{
		var out = [];

		if true {
			int a;
			double b;

			let [a, b] = pair;
			let out = [a, b];
		}

		return out;
	}

	public function iteratorKeys(var it) -> array
	{
		var out = [];

		if true {
			var k, v;

			for k, v in iterator(it) {
				let out[k] = v;
			}
		}

		return out;
	}

	public function iteratorAnonymousKey(var it) -> array
	{
		var out = [], v;

		for _, v in iterator(it) {
			let out[] = v;
		}

		return out;
	}

	public function typedArray(var value) -> array
	{
		array out = [];

		if true {
			array a = value;
			let out = a;
		}

		return out;
	}
}
--USAGE--
/**
 * A local declared in a nested block is its own variable, `x$$N` in C. `let`,
 * `++`, `--`, a range loop, destructuring and an iterator key printed the
 * written name `x` instead: the build failed, or an outer local of the same
 * name was changed while reads in the block saw the inner one.
 *
 * The expected output is what PHP prints for the same code with every block
 * local renamed apart from the outer one.
 *
 * @see https://github.com/zephir-lang/zephir/issues/2772
 */
function t(string $label, callable $fn): void
{
    try {
        $result = $fn();
        echo $label, ': ', var_export($result, true), "\n";
    } catch (\Throwable $e) {
        echo $label, ': ', get_class($e), ': ', $e->getMessage(), "\n";
    }
}

$o = new \Stub\Issue2772();

t('issue', fn() => $o->issue(['a' => ['name' => 1], 'b' => []]));
t('natives', fn() => $o->natives(5));
t('shadowed', fn() => $o->shadowed());
t('increment/decrement', fn() => $o->incrementDecrement());
t('concat', fn() => $o->concat('v', 7, 2.25, true));
t('range loop', fn() => $o->rangeLoop());
t('destructure', fn() => $o->destructure([7, 2.5]));
t('iterator keys', fn() => $o->iteratorKeys(new \ArrayIterator(['a' => 1, 'b' => 2])));
t('iterator anonymous key', fn() => $o->iteratorAnonymousKey(new \ArrayIterator(['a' => 1, 'b' => 2])));
t('typed array', fn() => $o->typedArray([1]));
t('typed array, not an array', fn() => $o->typedArray(5));
--EXPECT--
issue: array (
  'a' => true,
  'b' => false,
)
natives: array (
  0 => 28,
  1 => 6,
  2 => 10,
  3 => 30,
  4 => 57.5,
  5 => true,
  6 => true,
  7 => 122,
  8 => 122,
)
shadowed: array (
  0 => 1,
  1 => 1.5,
  2 => true,
  3 => 'o',
  4 => 
  array (
    0 => 6,
    1 => 5.0,
    2 => true,
    3 => 'ix',
  ),
)
increment/decrement: array (
  0 => 0,
  1 => 
  array (
    0 => 11,
    1 => 1.5,
  ),
)
concat: array (
  0 => 'o',
  1 => 'ix51.517c2.251v',
)
range loop: array (
  0 => 1,
  1 => 2,
  2 => 3,
)
destructure: array (
  0 => 7,
  1 => 2.5,
)
iterator keys: array (
  'a' => 1,
  'b' => 2,
)
iterator anonymous key: array (
  0 => 1,
  1 => 2,
)
typed array: array (
  0 => 1,
)
typed array, not an array: TypeError: Cannot assign int to variable $a of type array
