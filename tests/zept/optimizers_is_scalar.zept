--TEST--
Optimizers is_scalar: scalars true, arrays/objects/closures/null false (port of tests/Extension/Optimizers/IsScalarTest.php)
--FILE--
namespace Stub\Optimizers;

class IsScalar
{
	public function testIntVar() -> bool
	{
		int a = 1;
		return is_scalar(a);
	}

    public function testDoubleVar() -> bool
    {
        double a = 1;
        return is_scalar(a);
    }

    public function testBoolVar() -> bool
    {
        bool a = true;
        return is_scalar(a);
    }

    public function testStringVar() -> bool
    {
        string a = "test string";
        return is_scalar(a);
    }

    public function testEmptyArrayVar() -> bool
    {
        array a = [];
        return is_scalar(a);
    }

    public function testVar() -> bool
    {
        var a = 1;
        return is_scalar(a);
    }

    public function testVarParameter(var a) -> bool
    {
        return is_scalar(a);
    }
}
--USAGE--
$test = new \Stub\Optimizers\IsScalar();

echo var_export($test->testIntVar(), true), "\n";
echo var_export($test->testDoubleVar(), true), "\n";
echo var_export($test->testBoolVar(), true), "\n";
echo var_export($test->testStringVar(), true), "\n";
echo var_export($test->testVar(), true), "\n";
echo var_export($test->testEmptyArrayVar(), true), "\n";

echo var_export($test->testVarParameter(1), true), "\n";
echo var_export($test->testVarParameter(1.0), true), "\n";
echo var_export($test->testVarParameter(true), true), "\n";
echo var_export($test->testVarParameter(false), true), "\n";
echo var_export($test->testVarParameter(''), true), "\n";
echo var_export($test->testVarParameter('test string'), true), "\n";
echo var_export($test->testVarParameter([]), true), "\n";
echo var_export($test->testVarParameter([1, 2, 3, 4, 5]), true), "\n";
echo var_export($test->testVarParameter($test), true), "\n";
echo var_export($test->testVarParameter(function (): void {}), true), "\n";
echo var_export($test->testVarParameter(null), true), "\n";
--EXPECT--
true
true
true
true
true
false
true
true
true
true
true
true
false
false
false
false
false
