--TEST--
Optimizers math: ldexp/sqrt/sin/cos/acos/asin/tan over int/double/var/literal/param forms (port of tests/Extension/Optimizers/MathTest.php)
--FILE--
namespace Stub\Optimizers;

class Ldexp
{
	public function testInt()
	{
		int x = 2;
		int exponent = 3;
		return ldexp(x, exponent);
	}
	public function testDoubleInt()
	{
		double x = 2.0;
		int exponent = 3;
		return ldexp(x, exponent);
	}
	public function testDouble()
	{
		double x = 2.0;
		double exponent = 3.0;
		return ldexp(x, exponent);
	}
	public function testVar()
	{
		var x = 2;
		var exponent = 3;
		return ldexp(x, exponent);
	}
	public function testIntValue1()
	{
		return ldexp(2, 3);
	}
	public function testIntParameter(int x, int exponent)
	{
		return ldexp(x, exponent);
	}
	public function testvarParameter(var x, var exponent)
	{
		return ldexp(x, exponent);
	}
}
--FILE--
namespace Stub\Optimizers;

class Sqrt
{
	public function testInt() { int a = 4; return sqrt(a); }
	public function testVar() { var a = 4; return sqrt(a); }
	public function testIntValue1() { return sqrt(4); }
	public function testIntValue2() { return sqrt(16); }
	public function testIntParameter(int a) { return sqrt(a); }
	public function testVarParameter(var a) { return sqrt(a); }
}
--FILE--
namespace Stub\Optimizers;

class Sin
{
	public function testInt() { int a = 4; return sin(a); }
	public function testVar() { var a = 4; return sin(a); }
	public function testIntValue1() { return sin(4); }
	public function testIntValue2() { return sin(16); }
	public function testIntParameter(int a) { return sin(a); }
	public function testVarParameter(var a) { return sin(a); }
}
--FILE--
namespace Stub\Optimizers;

class Cos
{
	public function testInt() { int a = 4; return cos(a); }
	public function testVar() { var a = 4; return cos(a); }
	public function testIntValue1() { return cos(4); }
	public function testIntValue2() { return cos(16); }
	public function testIntParameter(int a) { return cos(a); }
	public function testVarParameter(var a) { return cos(a); }
}
--FILE--
namespace Stub\Optimizers;

class ACos
{
	public function testInt() { int a = 1; return acos(a); }
	public function testVar() { var a = 1; return acos(a); }
	public function testIntValue1() { return acos(0); }
	public function testIntParameter(int a) { return acos(a); }
	public function testVarParameter(var a) { return acos(a); }
}
--FILE--
namespace Stub\Optimizers;

class ASin
{
	public function testInt() { int a = 1; return asin(a); }
	public function testVar() { var a = 1; return asin(a); }
	public function testIntValue1() { return asin(0); }
	public function testIntParameter(int a) { return asin(a); }
	public function testVarParameter(var a) { return asin(a); }
}
--FILE--
namespace Stub\Optimizers;

class Tan
{
	public function testInt() { int a = 0; return tan(a); }
	public function testVar() { var a = 0; return tan(a); }
	public function testVar2() { var a = 1; return tan(a); }
	public function testIntValue1() { return tan(1); }
	public function testIntValue2() { return tan(2); }
	public function testIntParameter(int a) { return tan(a); }
	public function testVarParameter(var a) { return tan(a); }
}
--USAGE--
// Compare ext math results against PHP's own functions so the test is
// independent of the exact float mantissa formatting / PHP version.
$ldexp = new \Stub\Optimizers\Ldexp();
echo var_export($ldexp->testInt() === 16.0, true), "\n";
echo var_export($ldexp->testVar() === 16.0, true), "\n";
echo var_export($ldexp->testIntValue1() === 16.0, true), "\n";
echo var_export($ldexp->testDoubleInt() === 16.0, true), "\n";
echo var_export($ldexp->testDouble() === 16.0, true), "\n";
echo var_export($ldexp->testIntParameter(8, 16) === 524288.0, true), "\n";
echo var_export($ldexp->testvarParameter(8, 16) === 524288.0, true), "\n";

$sqrt = new \Stub\Optimizers\Sqrt();
echo var_export($sqrt->testInt() === 2.0, true), "\n";
echo var_export($sqrt->testVar() === 2.0, true), "\n";
echo var_export($sqrt->testIntValue1() === 2.0, true), "\n";
echo var_export($sqrt->testIntValue2() === 4.0, true), "\n";
echo var_export($sqrt->testIntParameter(4) === 2.0, true), "\n";
echo var_export($sqrt->testIntParameter(16) === 4.0, true), "\n";
echo var_export($sqrt->testVarParameter(4) === 2.0, true), "\n";
echo var_export($sqrt->testVarParameter(16) === 4.0, true), "\n";

$sin = new \Stub\Optimizers\Sin();
echo var_export($sin->testInt() === sin(4), true), "\n";
echo var_export($sin->testVar() === sin(4), true), "\n";
echo var_export($sin->testIntValue1() === sin(4), true), "\n";
echo var_export($sin->testIntValue2() === sin(16), true), "\n";
echo var_export($sin->testIntParameter(4) === sin(4), true), "\n";
echo var_export($sin->testIntParameter(16) === sin(16), true), "\n";
echo var_export($sin->testVarParameter(4) === sin(4), true), "\n";
echo var_export($sin->testVarParameter(16) === sin(16), true), "\n";

$cos = new \Stub\Optimizers\Cos();
echo var_export($cos->testInt() === cos(4), true), "\n";
echo var_export($cos->testVar() === cos(4), true), "\n";
echo var_export($cos->testIntValue1() === cos(4), true), "\n";
echo var_export($cos->testIntValue2() === cos(16), true), "\n";
echo var_export($cos->testIntParameter(4) === cos(4), true), "\n";
echo var_export($cos->testIntParameter(16) === cos(16), true), "\n";
echo var_export($cos->testVarParameter(4) === cos(4), true), "\n";
echo var_export($cos->testVarParameter(16) === cos(16), true), "\n";

$acos = new \Stub\Optimizers\ACos();
echo var_export($acos->testInt() === acos(1), true), "\n";
echo var_export($acos->testVar() === acos(1), true), "\n";
echo var_export($acos->testIntValue1() === acos(0), true), "\n";
echo var_export($acos->testIntParameter(1) === acos(1), true), "\n";
echo var_export($acos->testIntParameter(0) === acos(0), true), "\n";
echo var_export($acos->testVarParameter(1) === acos(1), true), "\n";
echo var_export($acos->testVarParameter(0) === acos(0), true), "\n";

$asin = new \Stub\Optimizers\ASin();
echo var_export($asin->testInt() === asin(1), true), "\n";
echo var_export($asin->testVar() === asin(1), true), "\n";
echo var_export($asin->testIntValue1() === asin(0), true), "\n";
echo var_export($asin->testIntParameter(1) === asin(1), true), "\n";
echo var_export($asin->testIntParameter(0) === asin(0), true), "\n";
echo var_export($asin->testVarParameter(1) === asin(1), true), "\n";
echo var_export($asin->testVarParameter(0) === asin(0), true), "\n";

$tan = new \Stub\Optimizers\Tan();
echo var_export($tan->testInt() === tan(0), true), "\n";
echo var_export($tan->testVar() === tan(0), true), "\n";
echo var_export($tan->testVar2() === tan(1), true), "\n";
echo var_export($tan->testIntValue1() === tan(1), true), "\n";
echo var_export($tan->testIntValue2() === tan(2), true), "\n";
echo var_export($tan->testIntParameter(0) === tan(0), true), "\n";
echo var_export($tan->testIntParameter(1) === tan(1), true), "\n";
echo var_export($tan->testIntParameter(2) === tan(2), true), "\n";
echo var_export($tan->testIntParameter(3) === tan(3), true), "\n";
echo var_export($tan->testIntParameter(4) === tan(4), true), "\n";
echo var_export($tan->testVarParameter(0) === tan(0), true), "\n";
echo var_export($tan->testVarParameter(1) === tan(1), true), "\n";
echo var_export($tan->testVarParameter(2) === tan(2), true), "\n";
echo var_export($tan->testVarParameter(3) === tan(3), true), "\n";
echo var_export($tan->testVarParameter(4) === tan(4), true), "\n";
echo var_export($tan->testVarParameter('0') === tan(0), true), "\n";
