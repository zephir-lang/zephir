    public function testBooleanCastFromIntTrue1() -> boolean
    {
        return (boolean) 1;
    }

    public function testBooleanCastFromIntTrue2() -> boolean
    {
        return (boolean) 1000;
    }

    public function testBooleanCastFromIntFalse() -> boolean
    {
        return (boolean) 0;
