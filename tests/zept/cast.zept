        return (boolean) simpleObject;
    }

    public function testBooleanCastFromEmptyArray() -> boolean
    {
        var a = [];
        return (boolean) a;
    }

    public function testBooleanCastFromArray() -> boolean
    {
        var a = [1, 2, 3, 4];
        return (boolean) a;
    }

