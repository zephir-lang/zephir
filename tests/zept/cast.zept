    public function testFloatCastFromNull() -> float
    {
        return (float) null;
    }

    public function testFloatCastFromVariableEmptyArray() -> float
    {
        var a = [];
        return (float) a;
    }

    public function testFloatCastFromEmptyArray() -> float
    {
