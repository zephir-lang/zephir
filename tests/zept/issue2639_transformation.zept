--TEST--
Issue #2639: exceptions out of the twins generated by `internal-call-transformation`
--CONFIG--
{"optimizations": {"internal-call-transformation": true}}
--FILE--
namespace Stub;

/**
 * With the transformation on, an ordinary method also gets an `internal` twin,
 * and the call site uses it wherever PHP would have resolved the target
 * statically anyway (#2021): a `private` method of the class being compiled, a
 * `final` method, or `this` in a `final` class. Each of those therefore reaches
 * the same synthetic frame as the `internal` keyword does.
 */
class Issue2639Transformed
{
    private function privateThrow()
    {
        throw new \Exception("from private");
    }

    final protected function finalThrow()
    {
        throw new \RuntimeException("from final");
    }

    private function privateBuild()
    {
        var e;

        let e = new \Exception("built in private");

        return e->getMessage();
    }

    /** The Stub\Exceptions::doNoopException() shape from ExceptionsTest::testIssue1325. */
    public function caughtPrivate() -> string
    {
        var e, status;

        let status = "not reached";

        try {
            let status = this->privateThrow();
        } catch \Exception, e {
            let status = "caught " . e->getMessage();
        }

        return status;
    }

    public function caughtFinal() -> string
    {
        var e, status;

        let status = "not reached";

        try {
            let status = this->finalThrow();
        } catch \RuntimeException, e {
            let status = "caught " . e->getMessage();
        }

        return status;
    }

    public function build() -> string
    {
        return this->privateBuild();
    }

    public function uncaught()
    {
        return this->privateThrow();
    }
}
--FILE--
namespace Stub;

final class Issue2639Final
{
    protected function thrower()
    {
        throw new \DomainException("from final class");
    }

    public function caught() -> string
    {
        var e, status;

        let status = "not reached";

        try {
            let status = this->thrower();
        } catch \DomainException, e {
            let status = "caught " . e->getMessage();
        }

        return status;
    }
}
--USAGE--
$o = new \Stub\Issue2639Transformed();

echo $o->caughtPrivate(), "\n";
echo $o->caughtFinal(), "\n";
echo $o->build(), "\n";

try {
    $o->uncaught();
    echo "no exception\n";
} catch (\Throwable $e) {
    echo "propagated ", get_class($e), " ", $e->getMessage(), "\n";
}

echo (new \Stub\Issue2639Final())->caught(), "\n";
--EXPECT--
caught from private
caught from final
built in private
propagated Exception from private
caught from final class
