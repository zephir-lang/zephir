--TEST--
Issue #2522: inline closure init (var call = function(){...}), fn-keyword init, and two-step form all produce a callable Closure (port of tests/Extension/Issue2522Test.php)
--FILE--
namespace Stub;

class Issue2522
{
    public function inlineClosureIsCallable() -> bool
    {
        var call = function () {
            return 42;
        };

        return is_callable(call);
    }

    public function inlineClosureReturnsClosureInstance() -> bool
    {
        var call = function () {
            return 42;
        };

        return (call instanceof \Closure);
    }

    public function inlineFnKeywordIsCallable() -> bool
    {
        var call = fn () {
            return 42;
        };

        return is_callable(call);
    }

    public function twoStepClosureIsCallable() -> bool
    {
        var call;
        let call = function () {
            return 42;
        };

        return is_callable(call);
    }
}
--USAGE--
$sut = new \Stub\Issue2522();
echo var_export($sut->inlineClosureIsCallable(), true), "\n";
echo var_export($sut->inlineClosureReturnsClosureInstance(), true), "\n";
echo var_export($sut->inlineFnKeywordIsCallable(), true), "\n";
echo var_export($sut->twoStepClosureIsCallable(), true), "\n";
--EXPECT--
true
true
true
true
