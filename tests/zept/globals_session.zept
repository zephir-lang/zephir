--TEST--
Globals\Session: __set/__unset/remove/destroy mutate the _SESSION superglobal (port of tests/Extension/Globals/SessionTest.php)
--FILE--
namespace Stub\Globals\Session;

class Base
{
	public function set(string index, var value)
	{
		let _SESSION[index] = value;

		return _SESSION;
	}

	public function remove(string index)
	{
		unset _SESSION[index];
	}

	public function __set(string index, var value)
	{
		return this->set(index, value);
	}

	public function __unset(string index)
	{
		this->remove(index);
	}

	protected function removeSessionData()
	{
		var key;

		for key, _ in _SESSION {
			unset _SESSION[key];
		}

		return _SESSION;
	}
}
--FILE--
namespace Stub\Globals\Session;

class Child extends Base
{
	public function destroy()
	{
		return this->removeSessionData();
	}
}
--USAGE--
// testDestroy: __set writes into _SESSION, destroy() clears it
$_SESSION = [];
$tester = new \Stub\Globals\Session\Child();
$tester->test = 'Some session data here';
echo var_export(array_key_exists('test', $_SESSION), true), "\n";
echo var_export(str_contains($_SESSION['test'], 'Some session data here'), true), "\n";
$result = $tester->destroy();
echo var_export($result, true), "\n";
echo var_export($_SESSION, true), "\n";
echo var_export($_SESSION === $result, true), "\n";

// testDirectUnset: __unset removes the key
$_SESSION = ['bar' => 'foo'];
$tester->__unset('bar');
echo var_export($_SESSION, true), "\n";

// testRemove: remove() removes the key
$_SESSION = ['foo' => 'bar'];
$tester->remove('foo');
echo var_export($_SESSION, true), "\n";

// testRemoveFromUnset: PHP unset($obj->prop) triggers __unset
$_SESSION = ['bar' => 'foo'];
unset($tester->bar);
echo var_export($_SESSION, true), "\n";
--EXPECT--
true
true
array (
