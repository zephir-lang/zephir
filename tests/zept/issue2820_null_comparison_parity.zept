--TEST--
Issue #2820: `==`, `!=` and the ordering operators between null and a var, mixed, string or array operand compare as PHP does, `===` and `!==` stay a type test, and a nullable string or array parameter keeps an explicit null
--FILE--
namespace Stub;

class NullComparison
{
    protected p;

    public function identity(var v)
    {
        return v;
    }

    public function varRight(var x) -> string
    {
        return (x == null ? "1" : "0")
            . (x != null ? "1" : "0")
            . (x === null ? "1" : "0")
            . (x !== null ? "1" : "0")
            . (x < null ? "1" : "0")
            . (x <= null ? "1" : "0")
            . (x > null ? "1" : "0")
            . (x >= null ? "1" : "0");
    }

