function outcome(callable $call): string
{
    $diagnostics = [];
    set_error_handler(function ($no, $message) use (&$diagnostics) {
        $diagnostics[] = $message;

        return true;
    });
    ob_start();
    try {
        $result = 'ok ' . var_export($call(), true);
    } catch (\Throwable $e) {
        $result = get_class($e) . ': ' . $e->getMessage();
    } finally {
        restore_error_handler();
    }

    return $result . ' | echoed=' . ob_get_clean() . ' | diag=' . implode(';', $diagnostics);
}

/**
 * A property name PHP converts once per operation.
 */
class Name
{
    public function __toString(): string
    {
        echo 'toString;';

        return 'p';
    }
}

$values = [3, 'abc', 0, 2.5, 'x', null];
// Names of an existing property, one of them converted once. A name that
// creates a property differs: PHP's ASSIGN_OBJ_OP creates it and warns
// "Undefined property" before the operator, where Zephir reads it silently.
$names  = ['p', new Name()];

$cases = 0;
$diffs = 0;
foreach (get_class_methods(PhpPropertyCompound::class) as $method) {
    if ('bump' === $method) {
        continue;
    }
    foreach (str_contains($method, 'DynVar') ? $names : ['p'] as $name) {
        foreach ($values as $value) {
            $cases++;
            $zephir = outcome(fn () => (new PropertyCompound())->$method($name, $value));
            $php    = outcome(fn () => (new PhpPropertyCompound())->$method($name, $value));
            if ($zephir !== $php) {
                $diffs++;
                echo $method, '(', json_encode([$name, $value], JSON_PARTIAL_OUTPUT_ON_ERROR), "): DIFF\n  zephir: $zephir\n  php:    $php\n";
            }
        }
    }
}
echo $cases, " cases, $diffs diffs\n";
--EXPECT--
660 cases, 0 diffs
