--TEST--
Compound assignments on object, static and dynamic properties behave as in PHP, including when the right-hand side changes the property (#2753)
--INI--
display_errors=stdout
display_startup_errors=1
--FILE--
namespace Stub;

class PropertyCompound
{
    public p = 5;

    public static s = 5;

    public function bump(var v)
    {
        let this->p = 100,
            self::s = 100;

        return v;
    }

    public function addPropValue(var n, var v)
    {
        var e, caught = null;

        let this->p = 5,
            self::s = 5;
        try {
            let this->p += v;
            echo "after";
        } catch \Throwable, e {
            let caught = get_class(e) . ": " . e->getMessage();
        }

        return [caught, this->p, self::s, get_object_vars(this)];
    }

    public function addPropCall(var n, var v)
    {
        var e, caught = null;

