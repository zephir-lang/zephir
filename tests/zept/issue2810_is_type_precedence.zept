    'm115' => [fn($v) => true !== is_resource($v), 'true !== is_resource(v)'],
    'm116' => [fn($v) => is_resource($v) !== true, 'is_resource(v) !== true'],
    'm117' => [fn($v) => false !== is_resource($v), 'false !== is_resource(v)'],
    'm118' => [fn($v) => is_resource($v) !== false, 'is_resource(v) !== false'],
    'm119' => [fn($v, $b) => $b !== is_resource($v), 'b !== is_resource(v)', true],
];
$checked = 0; $diffs = 0;
foreach ($cases as $method => $case) {
    foreach ($values as $label => $value) {
        foreach (isset($case[2]) ? [true, false] : [null] as $b) {
            $expected = $b === null ? $case[0]($value) : $case[0]($value, $b);
            $actual = $b === null ? \Stub\IsTypePrecedence::$method($value) : \Stub\IsTypePrecedence::$method($value, $b);
            $checked++;
            if ($actual !== $expected) {
                $diffs++;
                echo "DIFF {$case[1]} v={$label}", $b === null ? '' : ' b=' . var_export($b, true), ": zephir ", var_export($actual, true), " php ", var_export($expected, true), "\n";
            }
        }
    }
}
echo "checked {$checked}, diffs {$diffs}\n";
--EXPECT--
checked 1008, diffs 0
