--TEST--
Persistent array defaults are copied on write, not shared and mutated (#2651)
--FILE--
namespace Stub\Shared;

class Bag
{
    const MAP = ["a": "first", "b": "second"];

    protected array headers = [];

    protected array preset = ["x": "one", "y": "two"];

    protected array nested = ["outer": ["inner": "deep"]];

    public function toArray() -> array
    {
        return this->headers;
    }

    public function getPreset() -> array
    {
        return this->preset;
    }

    public function getNested() -> array
    {
        return this->nested;
    }
}
--FILE--
namespace Stub\Shared;

trait ArrayHolder
{
    protected tags = [1, 2, 3];

    protected meta = ["a": 1, "b": [2, 3]];

    public function getTags() -> array
    {
        return this->tags;
    }

    public function getMeta() -> array
    {
        return this->meta;
    }
}
--USAGE--
class PhpBag {
    const MAP = ["a" => "first", "b" => "second"];
    protected array $headers = [];
    protected array $preset  = ["x" => "one", "y" => "two"];
    protected array $nested  = ["outer" => ["inner" => "deep"]];
    public function toArray(): array   { return $this->headers; }
    public function getPreset(): array { return $this->preset; }
    public function getNested(): array { return $this->nested; }
}
class PhpHolder { use \Stub\Shared\ArrayHolder; }

function probe(string $label, callable $make, string $constant): void {
    $a = $make()->toArray();   $a["X-Leak"] = "polluted";
    $b = $make()->getPreset(); $b["z"] = "three";
    $c = $make()->getNested(); $c["outer"]["inner"] = "overwritten";
    $d = constant($constant . "::MAP"); $d["c"] = "third";
    unset($a, $b, $c, $d);

    echo $label, " headers=", json_encode($make()->toArray()), "\n";
    echo $label, " preset=",  json_encode($make()->getPreset()), "\n";
    echo $label, " nested=",  json_encode($make()->getNested()), "\n";
    echo $label, " const=",   json_encode(constant($constant . "::MAP")), "\n";
}

probe("zephir", fn() => new \Stub\Shared\Bag(), "\\Stub\\Shared\\Bag");
probe("php   ", fn() => new PhpBag(),           "PhpBag");

// Trait defaults reach a userland class through the same persistent path.
$h = new PhpHolder();
$t = $h->getTags(); $t[] = 4;
$m = $h->getMeta();  $m["b"][] = 99; $m["c"] = "added";
unset($t, $m);
echo "trait tags=", json_encode((new PhpHolder())->getTags()), "\n";
echo "trait meta=", json_encode((new PhpHolder())->getMeta()), "\n";

// Separate and discard repeatedly: zend_array_dup()'s immutable branch memcpys
// the buckets without an addref, so a copy must never release the shared keys
// and values when it is destroyed.
for ($i = 0; $i < 200; $i++) {
    $p = (new \Stub\Shared\Bag())->getPreset(); $p["z"] = "three"; unset($p);
    $k = \Stub\Shared\Bag::MAP; $k["c"] = "third"; unset($k);
    $churn = array_fill(0, 32, str_repeat("c", 8)); unset($churn);
}
echo "after churn preset=", json_encode((new \Stub\Shared\Bag())->getPreset()), "\n";
echo "after churn const=",  json_encode(\Stub\Shared\Bag::MAP), "\n";
--EXPECT--
zephir headers=[]
zephir preset={"x":"one","y":"two"}
zephir nested={"outer":{"inner":"deep"}}
zephir const={"a":"first","b":"second"}
php    headers=[]
php    preset={"x":"one","y":"two"}
php    nested={"outer":{"inner":"deep"}}
php    const={"a":"first","b":"second"}
trait tags=[1,2,3]
trait meta={"a":1,"b":[2,3]}
after churn preset={"x":"one","y":"two"}
after churn const={"a":"first","b":"second"}
