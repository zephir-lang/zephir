--TEST--
BuiltIn int methods: abs/pow/sqrt/exp/log, trigonometry, toBinary/toHex/toOctal (port of tests/Extension/BuiltIn/IntMethodTest.php)
--FILE--
namespace Stub\BuiltIn;

class IntMethods
{
    public function getAbs(int num)
    {
        return num->abs();
    }

    public function getAbs1()
    {
        return -5->abs();
    }

    public function getBinary(int num)
    {
        return num->toBinary();
    }

    public function getHex(int num)
    {
        return num->toHex();
    }

    public function getOctal(int num)
    {
        return num->toOctal();
    }

    public function getPow(int num, int exp)
    {
        return num->pow(exp);
    }

    public function getSqrt(int num)
    {
        return num->sqrt();
    }

    public function getExp(int num)
    {
        return num->exp();
    }

    public function getSin(int num)
    {
        return num->sin();
    }

    public function getCos(int num)
    {
        return num->cos();
    }

    public function getTan(int num)
    {
        return num->tan();
    }

    public function getAsin(int num)
    {
        return num->asin();
    }

    public function getAcos(int num)
    {
        return num->acos();
    }

    public function getAtan(int num)
    {
        return num->atan();
    }

    public function getLog(int num, int base = -1)
    {
        if base === -1 {
            return num->log();
        }
        return num->log(base);
    }
}
--USAGE--
$test = new \Stub\BuiltIn\IntMethods();
echo var_export($test->getAbs(10), true), "\n";
echo var_export($test->getAbs1(), true), "\n";
echo var_export($test->getPow(2, 4), true), "\n";
echo var_export($test->getSqrt(4), true), "\n";
// Transcendental results are libm-dependent and differ by ~1 ULP across
// platforms (e.g. tan(1) prints 1.5574077246549023 on glibc but
// 1.557407724654902 on macOS), so assert parity with PHP's own builtins —
// which use the same libm the extension links against — rather than a
// hardcoded literal. Mirrors the original assertSame(exp(2), getExp(2)) port.
echo var_export($test->getExp(2) === exp(2), true), "\n";
echo var_export($test->getLog(10) === log(10), true), "\n";
echo var_export($test->getLog(10, 10), true), "\n";
echo var_export($test->getSin(1) === sin(1), true), "\n";
echo var_export($test->getCos(1) === cos(1), true), "\n";
echo var_export($test->getTan(1) === tan(1), true), "\n";
echo var_export($test->getAsin(1) === asin(1), true), "\n";
echo var_export($test->getAcos(1), true), "\n";
echo var_export($test->getAtan(1) === atan(1), true), "\n";
echo var_export($test->getBinary(255), true), "\n";
echo var_export($test->getHex(255), true), "\n";
echo var_export($test->getOctal(255), true), "\n";
--EXPECT--
10
5
16
2.0
true
true
1.0
true
true
true
true
0.0
true
'11111111'
'ff'
'377'
