--TEST--
Issue #2409: assigning empty string / various scalar+array+typed-variable values to a static property compiles and round-trips (port of tests/Extension/Issue2409Test.php)
--FILE--
namespace Stub;

class Issue2409
{
    protected static someVar;

    public static function setEmpty() -> void
    {
        let self::someVar = "";
    }

    public static function setNonEmpty() -> void
    {
        let self::someVar = "123";
    }

    public static function setNull() -> void
    {
        let self::someVar = null;
    }

    public static function setInt() -> void
    {
        let self::someVar = 42;
    }

    public static function setNegativeInt() -> void
    {
        let self::someVar = -7;
    }

    public static function setDouble() -> void
    {
        let self::someVar = 3.14;
    }

    public static function setBoolTrue() -> void
    {
        let self::someVar = true;
    }

    public static function setBoolFalse() -> void
    {
        let self::someVar = false;
    }

    public static function setChar() -> void
    {
        char ch = 'A';
        let self::someVar = ch;
    }

    public static function setEmptyArray() -> void
    {
        let self::someVar = [];
    }

    public static function setArray() -> void
    {
        let self::someVar = [1, 2, 3];
    }

    public static function setFromStringVariable() -> void
    {
        string tmp = "hello";
        let self::someVar = tmp;
    }

    public static function setFromIntVariable() -> void
    {
        int tmp = 99;
        let self::someVar = tmp;
    }

    public static function setFromDoubleVariable() -> void
    {
        double tmp = 2.5;
        let self::someVar = tmp;
    }

    public static function setFromBoolVariable() -> void
    {
        bool tmp = true;
        let self::someVar = tmp;
    }

    public static function getVar()
    {
        return self::someVar;
    }
}
--USAGE--
\Stub\Issue2409::setEmpty();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setNonEmpty();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setNull();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setInt();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setNegativeInt();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setDouble();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setBoolTrue();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setBoolFalse();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setChar();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setEmptyArray();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setArray();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setFromStringVariable();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setFromIntVariable();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setFromDoubleVariable();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
\Stub\Issue2409::setFromBoolVariable();
echo var_export(\Stub\Issue2409::getVar(), true), "\n";
--EXPECT--
''
'123'
NULL
42
-7
3.14
true
false
65
array (
)
array (
  0 => 1,
  1 => 2,
  2 => 3,
)
'hello'
99
2.5
true
